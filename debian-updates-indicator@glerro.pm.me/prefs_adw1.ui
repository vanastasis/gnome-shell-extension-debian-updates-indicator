<interface domain="gnome-shell-extension-debian-updates-indicator">
  <requires lib="adw" version="1.0"/>

  <object class="GtkAdjustment" id="Adjust_interval">
    <property name="lower">0</property>
    <property name="upper">99</property>
    <property name="step_increment">1</property>
  </object>

  <object class="GtkAdjustment" id="Adjust_expand_list">
    <property name="lower">0</property>
    <property name="upper">500</property>
    <property name="step_increment">1</property>
  </object>

  <object class="AdwPreferencesRow" id="new_item_row">
    <property name="action-name">ignore-list.add</property>
    <child>
        <object class="GtkImage">
          <property name="icon-name">list-add-symbolic</property>
          <property name="pixel-size">16</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
        </object>
    </child>
  </object>

  <object class="AdwPreferencesPage" id="basic_settings_page">
    <property name="name">basic-settings-page</property>
    <property name="title" translatable="yes">Basic</property>
    <property name="icon-name">folder-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup" id="check_updates_group">
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Check for updates every:</property>
            <property name="subtitle" translatable="yes">Automatic checks, 0 to disable</property>
            <property name="activatable-widget">interval</property>
            <child>
              <object class="GtkSpinButton" id="interval">
                <property name="halign">end</property>
                <property name="valign">center</property>
                <property name="adjustment">Adjust_interval</property>
                <property name="numeric">1</property>
                <property name="update-policy">if-valid</property>
              </object>
            </child>
            <child>
              <object class="GtkComboBoxText" id="interval_unit_combo">
                <property name="valign">center</property>
                  <items>
                    <item translatable="yes" id="0">Hours</item>
                    <item translatable="yes" id="1">Days</item>
                    <item translatable="yes" id="2">Weeks</item>
                  </items>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="updates_menu_group">
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Strip out version numbers</property>
            <property name="activatable-widget">strip_versions_switch</property>
            <child>
              <object class="GtkSwitch" id="strip_versions_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Highlight security/important updates</property>
            <property name="activatable-widget">urgent_updates_switch</property>
            <child>
              <object class="GtkSwitch" id="urgent_updates_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="indicator_group">
        <child>
          <object class="AdwExpanderRow">
            <property name="title" translatable="yes">Indicator</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Always show the indicator</property>
                <property name="activatable-widget">always_visible</property>
                <child>
                  <object class="GtkSwitch" id="always_visible">
                    <property name="valign">center</property>
                    <property name="halign">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Show updates count on the indicator</property>
                <property name="activatable-widget">show_count</property>
                <child>
                  <object class="GtkSwitch" id="show_count">
                    <property name="valign">center</property>
                    <property name="halign">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Auto-expand updates list</property>
                <property name="subtitle" translatable="yes">If updates count is less than this number (0 to disable)</property>
                <property name="activatable-widget">auto_expand_list</property>
                <child>
                  <object class="GtkSpinButton" id="auto_expand_list">
                    <property name="visible">1</property>
                    <property name="adjustment">Adjust_expand_list</property>
                    <property name="halign">end</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="notifications_group">
        <child>
          <object class="AdwExpanderRow">
            <property name="title" translatable="yes">Notifications</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Send a notification when new updates are available</property>
                <property name="activatable-widget">notifications</property>
                <child>
                  <object class="GtkSwitch" id="notifications">
                    <property name="valign">center</property>
                    <property name="halign">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Use transient notifications (auto dismiss)</property>
                <property name="activatable-widget">transient_notifications</property>
                <child>
                  <object class="GtkSwitch" id="transient_notifications">
                    <property name="valign">center</property>
                    <property name="halign">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="verbosity">
                <property name="title" translatable="yes">How much information to show on notifications</property>
                <property name="subtitle" translatable="yes">Up to a maximum of 50 package names.</property> -->
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Count only</item>
                      <item translatable="yes">New updates names</item>
                      <item translatable="yes">All updates names</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="shortcut_group">
        <child>
          <object class="AdwActionRow" id="shortcut_row">
            <property name="title" translatable="yes">Shortcut to open the indicator</property>
            <property name="subtitle" translatable="yes"><![CDATA[Syntax: <Shift>, <Ctrl>, <Alt>, <Super>]]></property>
            <property name="activatable-widget">use_shortcut</property>
            <child>
              <object class="GtkEntry" id="shortcut_entry">
                <property name="width-chars">18</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkSwitch" id="use_shortcut">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesPage" id="advanced_settings_page">
    <property name="name">advanced_settings_page</property>
    <property name="title" translatable="yes">Advanced</property>
    <property name="icon-name">folder-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup" id="reset_group">
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Reset values for all commands</property>
            <child>
              <object class="GtkButton" id="reset_button">
                <property name="label" translatable="1">Reset</property>
                <property name="receives_default">1</property>
                <property name="halign">end</property>
                <property name="valign">center</property>
                <style>
                  <class name="destructive-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="update_command_group">
        <child>
          <object class="AdwExpanderRow" id="update_cmd_button">
            <property name="title" translatable="yes">Update method</property>
            <property name="subtitle" translatable="yes">Method to use to apply the updates.</property>
            <child type="action">
              <object class="GtkComboBoxText" id="update_cmd_options">
                <property name="valign">center</property>
                  <items>
                    <item translatable="yes">Launch Gnome Software</item>
                    <item translatable="yes">Launch Synaptic Package Manager</item>
                    <item translatable="yes">Launch Gnome PackageKit Update Viewer</item>
                    <item translatable="yes">Launch Ubuntu Update Manager</item>
                    <item translatable="yes">Custom</item>
                  </items>
              </object>
            </child>
            <child>
                <object class="AdwActionRow">
                    <property name="title" translatable="yes">Command to update packages &lt;span size=&quot;small&quot;&gt;(You can use sudo instead of pkexec for the terminal)&lt;/span&gt;</property>
                    <child>
                      <object class="GtkEntry" id="field_updatecmd">
                            <property name="width-chars">18</property>
                            <property name="valign">center</property>
                      </object>
                    </child>
                </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Show output on terminal</property>
                <property name="activatable-widget">output_on_terminal_switch</property>
                <child>
                  <object class="GtkSwitch" id="output_on_terminal_switch">
                    <property name="valign">center</property>
                    <property name="halign">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
                <object class="AdwActionRow">
                    <property name="title" translatable="yes">Terminal to use &lt;span size=&quot;small&quot;&gt;(Ex: xterm -e)&lt;/span&gt;</property>
                    <child>
                      <object class="GtkEntry" id="terminal_entry">
                            <property name="width-chars">18</property>
                            <property name="valign">center</property>
                      </object>
                    </child>
                </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="check_command_group">
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Use a custom command to check for updates</property>
            <property name="subtitle" translatable="yes">The default command is &quot;pkcon refresh&quot;, which uses packagekit with the apt backend. You can define a custom command below, to be executed using pkexec.</property>
            <property name="activatable-widget">use_custom_cmd_switch</property>
            <child>
              <object class="GtkSwitch" id="use_custom_cmd_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Custom command to check for updates</property>
            <child>
              <object class="GtkEntry" id="field_checkcmd_custom">
                <property name="width-chars">18</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesPage" id="packages_status_page">
    <property name="name">packages_status_page</property>
    <property name="title" translatable="yes">Packages</property>
    <property name="icon-name">folder-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup" id="new_packages_group">
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">New packages in repository</property>
            <property name="subtitle" translatable="yes">Include an item in the indicator with a list of new packages in the repository.</property>
            <property name="activatable-widget">new_packages_switch</property>
            <child>
              <object class="GtkSwitch" id="new_packages_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Local/Obsolete packages</property>
            <property name="subtitle" translatable="yes">Include an item in the indicator with a list of obsolete or local packages. Obsolete packages are not available in the repository. Local packages are available, but an unavailable version is installed.</property>
            <property name="activatable-widget">obsolete_packages_switch</property>
            <child>
              <object class="GtkSwitch" id="obsolete_packages_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Residual packages</property>
            <property name="subtitle" translatable="yes">Include an item in the indicator with a list of packages that have residual config files. Run &quot;sudo apt purge pkgname&quot; to clean them.</property>
            <property name="activatable-widget">residual_packages_switch</property>
            <child>
              <object class="GtkSwitch" id="residual_packages_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Autoremovable packages</property>
            <property name="subtitle" translatable="yes">Include an item in the indicator with a list of autoremovable packages. Run &quot;sudo apt autoremove&quot; to remove them.</property>
            <property name="activatable-widget">autoremovable_packages_switch</property>
            <child>
              <object class="GtkSwitch" id="autoremovable_packages_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesPage" id="ignore_list_page">
    <property name="name">ignore_list_page</property>
    <property name="title" translatable="yes">Ignore</property>
    <property name="icon-name">view-list-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup" id="ignore_list_group">
        <property name="title" translatable="yes">Packages in this list will be excluded from the updates.</property>
        <property name="description" translatable="yes">As an example, this is useful for packages that are downgraded manually.</property>
      </object>
    </child>
  </object>

</interface>

