<interface domain="gnome-shell-extension-debian-updates-indicator">
  <template class="DebianUpdatesAddShortcutsWindow" parent="AdwWindow">
    <property name="modal">true</property>
    <property name="hide-on-close">true</property>
    <property name="height-request">240</property>
    <property name="width-request">370</property>
    <property name="resizable">false</property>
    <property name="content">
      <object class="AdwStatusPage">
        <property name="title" translatable="true">Press shortcut keys...</property>
        <property name="description" translatable="yes">Press Esc to exit or Backspace to clear</property>
        <property name="icon-name">preferences-desktop-keyboard-shortcuts-symbolic</property>
      </object>
    </property>
  </template>
</interface>

