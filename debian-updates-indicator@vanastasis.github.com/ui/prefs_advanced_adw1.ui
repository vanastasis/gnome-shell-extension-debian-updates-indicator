<interface domain="gnome-shell-extension-debian-updates-indicator">
  <template class="DebianUpdatesAdvancedPrefsPage" parent="AdwPreferencesPage">
    <property name="name">advanced_settings_page</property>
    <property name="title" translatable="yes">Advanced</property>
    <property name="icon-name">folder-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup" id="reset_group">
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Reset values for all commands</property>
            <child>
              <object class="GtkButton" id="reset_button">
                <property name="child">
                  <object class="AdwButtonContent">
                    <property name="icon-name">view-refresh-symbolic</property>
                    <property name="label" translatable="yes">Reset</property>
                  </object>
                </property>
                <property name="receives_default">true</property>
                <property name="valign">center</property>
                <style>
                  <class name="destructive-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="update_command_group">
        <child>
          <object class="AdwExpanderRow" id="update_cmd_button">
            <property name="title" translatable="yes">Update method</property>
            <property name="subtitle" translatable="yes">Method to use to apply the updates.</property>
            <child type="action">
              <object class="GtkDropDown" id="update_cmd_options">
                <property name="valign">center</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Gnome Software</item>
                      <item>Synaptic Package Manager</item>
                      <item>Gnome PackageKit Update Viewer</item>
                      <item>Ubuntu Update Manager</item>
                      <item translatable="yes">Custom</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="field_updatecmd">
                <property name="title" translatable="yes">Command to update packages &lt;span size=&quot;small&quot;&gt;(You can use sudo instead of pkexec for the terminal)&lt;/span&gt;</property>
                <property name="show-apply-button">true</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="output_on_terminal_switch">
                <property name="title" translatable="yes">Show output on terminal</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="terminal_entry">
                <property name="title" translatable="yes">Terminal to use &lt;span size=&quot;small&quot;&gt;(Ex: xterm -e)&lt;/span&gt;</property>
                <property name="show-apply-button">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="check_command_group">
        <child>
          <object class="AdwSwitchRow" id="use_custom_cmd_switch">
            <property name="title" translatable="yes">Use a custom command to check for updates</property>
            <property name="subtitle" translatable="yes">The default command is &quot;pkcon refresh&quot;, which uses packagekit with the apt backend. You can define a custom command below, to be executed using pkexec.</property>
          </object>
        </child>
        <child>
          <object class="AdwEntryRow" id="field_checkcmd_custom">
            <property name="title" translatable="yes">Custom command to check for updates</property>
            <property name="show-apply-button">true</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>

