msgid "Local/Obsolete packages"
msgstr "Локальні/Застарілі пакети"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:175
msgid "Residual config files"
msgstr "Встановлені (залишились файли налаштувань)"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:178
msgid "Autoremovable"
msgstr "Непотрібні пакети (автовидалення)"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:182
msgid "Apply updates"
msgstr "Застосувати оновлення"

