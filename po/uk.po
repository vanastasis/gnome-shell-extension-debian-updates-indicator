msgid "New Update"
msgid_plural "New Updates"
msgstr[0] "Нових оновлень"
msgstr[1] "Нове оновлення"
msgstr[2] "Нових оновлень"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:413
#, javascript-format
msgid "There is %d update pending"
msgid_plural "There are %d updates pending"
msgstr[0] "Доступно %d оновлення, що очікує"
msgstr[1] "Доступно %d оновлення, що очікують"
msgstr[2] "Доступно %d оновлень, що очікує"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:617
msgid "Update now"
msgstr "Оновити зараз"

#: debian-updates-indicator@vanastasis.github.com/monitors.js:80
#: debian-updates-indicator@vanastasis.github.com/monitors.js:89
#, javascript-format
msgid "Can not connect to %s"
msgstr "Неможливо зʼєднатися з %s"

#: debian-updates-indicator@vanastasis.github.com/updateManager.js:641
msgid "Last check: "
msgstr "Остання перевірка: "

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:29
msgid "Basic"
msgstr "Основні"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:35
msgid "Check for updates every:"
msgstr "Перевіряти оновлення кожні: "

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:36
msgid "Automatic checks, 0 to disable"
msgstr "Автоматичні перевірки, 0 - відключити"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:55
msgid "Hours"
msgstr "Годин(а)"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:56
msgid "Days"
msgstr "Дні(в)"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:57
msgid "Weeks"
msgstr "Тиждень(ів)"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:71
msgid "Strip out version numbers"
msgstr "Не показувати номери версій"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:76
msgid "Highlight security/important updates"
msgstr "Позначати оновлення безпеки/важливі оновлення"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:85
msgid "Indicator"
msgstr "Індикатор на панелі"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:88
msgid "Always show the indicator"
msgstr "Завжди показувати індикатор"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:93
msgid "Show updates count on the indicator"
msgstr "Показувати кількість оновлень"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:98
msgid "Auto-expand updates list"
msgstr "Розгортати перелік оновлень"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:99
msgid "If updates count is less than this number (0 to disable)"
msgstr "Якщо кількість оновлень менше цієї кількості (0 для відключення)"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:121
msgid "Notifications"
msgstr "Сповіщення"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:124
msgid "Send a notification when new updates are available"
msgstr "Показати сповіщення коли доступні нові оновлення"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:129
msgid "Use transient notifications (auto dismiss)"
msgstr "Показати миттєві сповіщення"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:134
msgid "How much information to show on notifications"
msgstr "Як багато інформації показувати на сповіщеннях"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:135
msgid "Up to a maximum of 50 package names."
msgstr "Максимально до 50 назв пакетів."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:139
msgid "Count only"
msgstr "Тільки кількість"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:140
msgid "New updates names"
msgstr "Назви нових оновлень"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:141
msgid "All updates names"
msgstr "Назви всіх оновлень"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:155
msgid "Enable shortcut"
msgstr "Увімкнути клавіатурне скорочення"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:160
msgid "Shortcut to toggle the menu"
msgstr "Клавіатурне скорочення для активації меню"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_basic_adw1.ui:164
msgid "Select a shortcut"
msgstr "Вибрати скорочення"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:29
msgid "Advanced"
msgstr "Додаткові"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:35
msgid "Reset values for all commands"
msgstr "Повернути значення команд за замовчуванням"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:41
msgid "Reset"
msgstr "Скинути"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:59
msgid "Update method"
msgstr "Спосіб оновлень"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:60
msgid "Method to use to apply the updates."
msgstr "Використовувати для застосування оновлень."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:71
msgid "Custom"
msgstr "Власний"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:79
msgid ""
"Command to update packages <span size=\"small\">(You can use sudo instead of "
"pkexec for the terminal)</span>"
msgstr ""
"Команда для оновлення пакетів <span size=\"small\">(Ви можете "
"використовувати sudo замість pkexec для терміналу)</span>"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:85
msgid "Show output on terminal"
msgstr "Показати вивід в терміналі"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:90
msgid "Terminal to use <span size=\"small\">(Ex: xterm -e)</span>"
msgstr "Термінал для виводу <span size=\"small\">(Наприклад: xterm -e)</span>"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:102
msgid "Use a custom command to check for updates"
msgstr "Використовувати власну команду для перевірки оновлень"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:103
msgid ""
"The default command is \"pkcon refresh\", which uses packagekit with the apt "
"backend. You can define a custom command below, to be executed using pkexec."
msgstr ""
"Команда за замовчуванням \"pkcon refresh\" використовує packagekit з "
"бекендом apt. Ви можете вказати власну команду нижче, для виконання з "
"використанням pkexec."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_advanced_adw1.ui:108
msgid "Custom command to check for updates"
msgstr "Власна команда для первірки оновлень"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_packages_status_adw1.ui:29
msgid "Packages"
msgstr "Пакети"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_packages_status_adw1.ui:35
msgid "New packages in repository"
msgstr "Нові пакети в репозиторії"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_packages_status_adw1.ui:36
msgid ""
"Include an item in the indicator with a list of new packages in the "
"repository."
msgstr ""
"Відображати пункт в меню індикатора на панелі з переліком нових пакетів в "
"репозиторії."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_packages_status_adw1.ui:42
msgid ""
"Include an item in the indicator with a list of obsolete or local packages. "
"Obsolete packages are not available in the repository. Local packages are "
"available, but an unavailable version is installed."
msgstr ""
"Відображати пункт в меню індикатора на панелі з переліком застарілих або "
"локальних пакетів. Застарілі пакети недоступні в репозиторії. Локальні "
"пакети доступні, але недоступна версія яка є встановленою."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_packages_status_adw1.ui:47
msgid "Residual packages"
msgstr "Встановлені пакети (залишились файли налаштування)"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_packages_status_adw1.ui:48
msgid ""
"Include an item in the indicator with a list of packages that have residual "
"config files. Run \"sudo apt purge pkgname\" to clean them."
msgstr ""
"Відображати пункт в меню індикатора на панелі з переліком пакетів, для яких "
"залишились файли налаштувань. Виконайте команду \"sudo apt purge pkgname\" "
"для їх видалення."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_packages_status_adw1.ui:53
msgid "Autoremovable packages"
msgstr "Непотрібні пакети (автовидалення)"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_packages_status_adw1.ui:54
msgid ""
"Include an item in the indicator with a list of autoremovable packages. Run "
"\"sudo apt autoremove\" to remove them."
msgstr ""
"Відображати пункт в меню індикатора на панелі з переліком непотрібних "
"пакетів (автовидалення)."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_ignore_list_adw1.ui:29
msgid "Ignore"
msgstr "Виключення"

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_ignore_list_adw1.ui:33
msgid "Packages in this list will be excluded from the updates."
msgstr "Пакети, що знаходяться в цьому переліку будуть виключені з оновлень."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_ignore_list_adw1.ui:34
msgid ""
"As an example, this is useful for packages that are downgraded manually."
msgstr "Це корисно, наприклад, для пакетів версія яких була знижена вручну."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_add_shortcuts_adw1.ui:35
msgid "Press shortcut keys..."
msgstr "Натисніть комбінацію клавіш..."

#: debian-updates-indicator@vanastasis.github.com/ui/prefs_add_shortcuts_adw1.ui:36
msgid "Press Esc to exit or Backspace to clear"
msgstr "Натисніть Esc для виходу або Backspace для очистки"
