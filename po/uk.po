msgstr[2] "%d оновлень очікує"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:359
msgid "Error"
msgstr "Помилка"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:363
msgid "No internet"
msgstr "Відсутнє з'єднання з мережею"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:366
msgid "Initializing"
msgstr "Перевірка"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:370
msgid "Up to date"
msgstr "Оновлено"

#: debian-updates-indicator@vanastasis.github.com/indicator.js:406
