#: debian-updates-indicator@glerro.pm.me/ui/prefs_basic_adw1.ui:86
msgid "Indicator"
msgstr "Значок на панели"

#: debian-updates-indicator@glerro.pm.me/ui/prefs_basic_adw1.ui:89
